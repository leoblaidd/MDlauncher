{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Launcher",
  "mainBinaryName": "MDLauncher",
  "version": "2.0.0",
  "identifier": "com.leoblaidd.mdlauncher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MD Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0a0b0e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "leoblaidd",
    "homepage": "https://github.com/leoblaidd/MDlauncher",
    "shortDescription": "Launcher para jogos de Mega Drive",
    "longDescription": "Biblioteca com capas para seus jogos de Mega Drive, compatível com qualquer emulador.",
    "category": "Game",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
